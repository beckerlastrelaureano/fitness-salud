rules_version = '2';

// Reglas de seguridad de Fitness Salud.
// Antes de pegarlas, poné el DNI real del dueño en esDueno() (el mismo de
// js/config.js). Se pegan en Firebase > Firestore Database > Reglas > Publicar.
//
// - Dueño: entra con DNI y contraseña. Puede todo.
// - Profes: entran con DNI. Pasan asistencia y manejan los turnos de sus actividades.
// - Alumnos: entran con DNI, sin sesión. Leen su ficha, sus turnos y su rutina y registran su día.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() { return request.auth != null; }
    function dniSesion() { return request.auth.token.email.split('@')[0]; }
    function esDueno() { return conSesion() && dniSesion() in ['20111222']; }
    function rutaEquipo() { return /databases/$(database)/documents/equipo/$(dniSesion()); }
    function esProfe() { return conSesion() && exists(rutaEquipo()); }
    function esEquipo() { return esDueno() || esProfe(); }
    function actividadesProfe() { return get(rutaEquipo()).data.actividades; }

    match /alumnos/{dni} {
      allow get: if true;
      allow list: if esEquipo();
      allow write: if esDueno();
      // El profe puede asignar una rutina, nada más.
      allow update: if esProfe()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rutinaId']);
    }

    // Teléfono y notas: solo el dueño.
    match /contactos/{dni} {
      allow read, write: if esDueno();
    }

    match /equipo/{dni} {
      allow get: if true;
      allow list: if esEquipo();
      allow write: if esDueno();
    }

    // Marca de que el dueño ya creó su contraseña. No guarda la contraseña.
    // Solo se puede crear desde el DNI del dueño.
    match /claves/{dni} {
      allow get: if true;
      allow write: if esDueno() && dni == dniSesion();
    }

    match /config/publico {
      allow read: if true;
      allow write: if esDueno();
    }

    // Nombres de ejercicios cambiados por el gimnasio.
    match /config/ejercicios {
      allow read: if true;
      allow write: if esEquipo();
    }

    // Los alumnos abren su rutina sin sesión, por eso la lectura de una es libre.
    match /rutinas/{id} {
      allow get: if true;
      allow list, write: if esEquipo();
    }

    match /ejercicios/{id} {
      allow read: if true;
      allow write: if esEquipo();
    }

    // Un turno no guarda nombres. El alumno lee los suyos por id. Cada profe
    // lista y cambia solo los turnos de sus actividades.
    match /turnos/{id} {
      allow get: if true;
      allow list: if esDueno() || (esProfe() && resource.data.actividad in actividadesProfe());
      allow create: if esDueno() || (esProfe() && request.resource.data.actividad in actividadesProfe());
      allow update: if esDueno() || (esProfe() && resource.data.actividad in actividadesProfe()
        && request.resource.data.actividad in actividadesProfe());
      allow delete: if esDueno() || (esProfe() && resource.data.actividad in actividadesProfe());
    }

    // Una marca por alumno y clase. El alumno lee las suyas por id.
    match /marcas/{id} {
      allow get: if true;
      allow create, delete: if esEquipo();
    }

    // Asistencia que registra el alumno. Solo puede crear la de un DNI que
    // exista, una por día, y con estos datos. No puede cambiarla ni borrarla.
    match /visitas/{id} {
      allow get: if true;
      allow list, delete: if esEquipo();
      allow create: if id == request.resource.data.fecha + '_' + request.resource.data.dni
        && request.resource.data.keys().hasOnly(['dni', 'fecha', 'dia', 'hora', 'por'])
        && request.resource.data.por == 'alumno'
        && exists(/databases/$(database)/documents/alumnos/$(request.resource.data.dni));
    }

    // Precios, combos y porcentajes.
    match /config/negocio {
      allow read, write: if esDueno();
    }

    match /asistencias/{id} {
      allow read: if esEquipo();
      allow write: if esDueno()
        || (esProfe() && request.resource.data.actividad in actividadesProfe());
    }

    match /pagos/{id} {
      allow read, write: if esDueno();
    }

    match /pagosProfes/{id} {
      allow read, write: if esDueno();
    }
  }
}
